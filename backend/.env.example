# Copy this file to .env and change the values
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/jobportal
DATABASE_URL=sqlite:///./jobportal.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional AI feedback. Get a key at https://aistudio.google.com/apikey and paste it here.
# Leave empty to run without AI feedback (match scores still work).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional real emails. Leave SMTP_HOST empty to print emails in the server terminal.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, and an "app password"
# from https://myaccount.google.com/apppasswords as SMTP_PASSWORD (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
